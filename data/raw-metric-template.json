  "field_contract": {
    "numeric": "直接率与balanced率用非负safe integer计数；分母必须>0。null、数字字符串、布尔、NaN、Infinity、小数和不安全整数都不能作已完成的计数。",
    "review": "complete须有不同reviewer1/2的id、judgment和reason，及独立第三人adjudication。adjudication.decision必须与顶层计数/锚点一致。此严格第三人签署是本草案执行规则。",
    "evidence": "reference_item_ids为非空不重复字符串数组；source_locators每项须有source_id、locator和evidence_note。引擎只校验结构，来源真实性仍需实际核查。",
    "status": "complete=全部原始值与审定证据齐备；omitted=漏交必需内容，计0；not_tested=未测，null；invalid=无效，null。",
    "d7_flags": "D7.1需要flags.required_event_count>0、right_censored_count=0、all_sla_windows_matured=true，denominator等于required_event_count。无事件或SLA前右删失为null；逾期未响应仍为失败。",
    "transforms": "只允许percent、identity_anchored、balanced_rate_percent三个操作。expression字符串仅为文档，不执行。",
    "score_return": "scoreMetric(metric, observation, profile)→{metric_id,score,status,errors,reasons}",
    "aggregate_return": "aggregateDimensions(catalog, observations, profile)→{profile,scores,metric_results,dimension_details,errors,disabled_dimensions,complete,valid,measured_dimension_weight,notice}"
  },
